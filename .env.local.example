# Copy this file to .env.local to point the site at your own Supabase
# project. If you skip this, the site falls back to the same project the
# original static site used (see lib/supabase.js).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
